# WP-39: felt-vision does NOT load a .env file today - unlike every other
# Felt repo, main.py reads these two keys straight from the process
# environment (os.environ.get), with no python-dotenv call. Copying this
# to .env has no effect by itself; set these as real OS/launcher
# environment variables (or wire up dotenv loading - a new chore, not
# done this WP since it'd be a behavior change) if you need non-default
# values. This file exists so both keys are discoverable at all - before
# WP-39 they were only findable by reading main.py. Both have working
# defaults below.

# Ollama's generate endpoint - felt-vision is a thin wrapper around a
# local multimodal model, not its own model server.
OLLAMA_URL=http://127.0.0.1:11434/api/generate

# Which Ollama model to send the screenshot to. Try `llava`, `moondream`,
# `qwen2-vl`, etc. — swap freely, felt-vision doesn't care which vision
# model answers as long as it accepts the /api/generate `images` field.
VISION_MODEL=llava
